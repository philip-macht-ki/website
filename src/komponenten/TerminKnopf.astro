---
import seite from '../../seite.json';

interface Props {
  text?: string;
}
const { text } = Astro.props as Props;
const termin = seite.termin;
---

{termin.an && termin.link && (
  <a
    class="knopf knopf--primaer"
    href={termin.link}
    target="_blank"
    rel="noopener noreferrer"
  >
    {text ?? termin.text}
  </a>
)}
